# Azure AI Foundry Configuration
# Your Azure AI Foundry project endpoint
AZURE_ENDPOINT=https://ph-foundry.services.ai.azure.com/api/projects/proj-default
# Your Azure AI API key
AZURE_API_KEY=your-api-key-here

# Model Configuration
# Vision model for slide analysis (default: gpt-4o)
AZURE_VISION_MODEL=gpt-4o
# Image editing model for text removal (default: FLUX.1-Kontext-pro)
AZURE_IMAGE_MODEL=FLUX.1-Kontext-pro

# Optional Settings
# PDF render DPI (default: 200)
PDF_DPI=200
# PPTX slide dimensions in inches (default: 13.333 x 7.5 = widescreen 16:9)
SLIDE_WIDTH=13.333
SLIDE_HEIGHT=7.5

# Debug mode (set to any value to enable stack traces)
# DEBUG=1
