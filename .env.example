# Azure AI Foundry Configuration
# Each model needs its own deployment endpoint and API key.
# Find these in Azure AI Foundry → Models + Endpoints → select deployment → Endpoint section.

# Vision model (GPT-4o) - for slide analysis
# The deployment endpoint URL (without /chat/completions)
AZURE_VISION_ENDPOINT=https://ph-foundry.cognitiveservices.azure.com/openai/deployments/gpt-4o
AZURE_VISION_API_KEY=your-vision-api-key-here

# Image model (FLUX.1-Kontext-pro) - for text removal from slide backgrounds
# The deployment endpoint URL (without /images/generations)
AZURE_IMAGE_ENDPOINT=https://ph-foundry.services.ai.azure.com/openai/deployments/FLUX.1-Kontext-pro
AZURE_IMAGE_API_KEY=your-image-api-key-here

# Optional Settings
# PDF render DPI (default: 200)
PDF_DPI=200
# PPTX slide dimensions in inches (default: 13.333 x 7.5 = widescreen 16:9)
SLIDE_WIDTH=13.333
SLIDE_HEIGHT=7.5

# Debug mode (set to any value to enable stack traces)
# DEBUG=1
